{
  "name": "@vidro/hibana",
  "version": "0.0.0",
  "description": "Backend-first FW on top of Hono, sibling of Vidro (Phase 1 Step 3-b: vite plugin で .island.tsx 自動発見)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./vite-client": "./vite-client.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/client.ts src/internal.ts src/vite.ts --dts",
    "dev": "vp pack src/index.ts src/client.ts src/internal.ts src/vite.ts --dts --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@types/babel__generator": "catalog:",
    "@types/babel__traverse": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vidro/core": "workspace:*",
    "hono": "^4.6.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vidro/core": "workspace:*",
    "hono": "^4.0.0",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
