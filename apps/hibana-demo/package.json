{
  "name": "hibana-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client.ts --bundle --outfile=dist/client/client.js --jsx=automatic --jsx-import-source=@vidro/core --format=esm --target=es2022 --platform=browser --external:node:*",
    "dev": "pnpm build:client && tsx watch src/app.ts",
    "start": "pnpm build:client && tsx src/app.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@vidro/core": "workspace:*",
    "@vidro/hibana": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.27.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
