{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@vidro/core",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["src", "vite.config.ts"]
}
